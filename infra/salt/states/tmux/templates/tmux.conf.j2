# use 256 colors
set -g default-terminal "tmux-256color"
set-option -ga terminal-overrides ",xterm-256color:Tc"
# prevent tmux from delaying the escape key
set -g escape-time 0
# Increase scrollback buffer size from 2000 to 50000 lines
set -g history-limit 50000
# Increase tmux messages display duration from 750ms to 4s
set -g display-time 4000
# Use emacs key bindings in command mode
set -g status-keys emacs
# start windows numbering at 1
set -g base-index 1
# make pane numbering consistent with windows
setw -g pane-base-index 1
# renumber windows when a window is closed
set -g renumber-windows on
# rename window to reflect current program
setw -g automatic-rename on
# set terminal title
set -g set-titles on
# redraw status line every 10 seconds
set -g status-interval 10
# split current window horizontally
bind - split-window -v
unbind '"'
# split current window vertically
bind = split-window -h
unbind %
# window navigation
bind C-p previous-window
bind C-n next-window
# pane navigation
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R
# pane resizing
bind -r H resize-pane -L 2
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 2
# swap current pane with the next one
bind > swap-pane -D
# swap current pane with the previous one
bind < swap-pane -U
# reload config
bind R source-file ~/.tmux.conf
# Enable mouse mode
set -g mouse on
# Status bar, generated with vim-tmuxline
set -g status-justify "left"
set -g status "on"
set -g status-left-style "none"
set -g message-command-style "fg=colour249,bg=colour237"
set -g status-right-style "none"
set -g pane-active-border-style "fg=colour150"
set -g status-style "none,bg=colour238"
set -g message-style "fg=colour249,bg=colour237"
set -g pane-border-style "fg=colour237"
set -g status-right-length "100"
set -g status-left-length "100"
setw -g window-status-activity-style "none"
setw -g window-status-separator ""
setw -g window-status-style "none,fg=colour150,bg=colour238"
set -g status-left "#[fg=colour236,bg=colour117] #S #[fg=colour117,bg=colour238,nobold,nounderscore,noitalics]"
set -g status-right "#[fg=colour237,bg=colour238,nobold,nounderscore,noitalics]#[fg=colour249,bg=colour237] %H:%M #[fg=colour117,bg=colour237,nobold,nounderscore,noitalics]#[fg=colour236,bg=colour117] #h "
setw -g window-status-format "#[fg=colour117,bg=colour238] #I #[fg=colour117,bg=colour238] #W "
setw -g window-status-current-format "#[fg=colour238,bg=colour237,nobold,nounderscore,noitalics]#[fg=colour249,bg=colour237] #I #[fg=colour249,bg=colour237] #W #[fg=colour237,bg=colour238,nobold,nounderscore,noitalics]"
{% if tpm_enabled %}

# Load plugins
set -g @plugin "tmux-plugins/tmux-open"
set -g @plugin "tmux-plugins/tmux-urlview"
set -g @plugin "tmux-plugins/tmux-yank"
set -g @yank_selection_mouse "clipboard"
run "~/.tmux/plugins/tpm/tpm"
{% endif %}{# if tpm_enabled #}
