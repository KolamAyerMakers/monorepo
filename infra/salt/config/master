failhard: true
root_dir: run
age_identity_command:
  - pass
  - infra/saltstack/age-identity/private
file_roots:
  base:
    - ./states
module_dirs:
  - ./states/_modules
  - ./states/_states
pillar_roots:
  base:
    - ./pillar
minion_opts:
  pillar_merge_lists: true
roster_defaults:
  user: root
  port: 22
  sudo: false
  ssh_options:
    - IdentitiesOnly=yes
rand_thin_dir: true
ssh_wipe: true
